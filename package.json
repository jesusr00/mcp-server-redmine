{
  "name": "mcp-server-redmine",
  "version": "0.7.0",
  "description": "MCP server for Redmine REST API",
  "type": "module",
  "bin": {
    "mcp-server-redmine": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "redmine",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusr00/mcp-server-redmine.git"
  },
  "homepage": "https://github.com/jesusr00/mcp-server-redmine#readme",
  "bugs": {
    "url": "https://github.com/jesusr00/mcp-server-redmine/issues"
  },
  "author": "Jesus Reikel Lopez Martin",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "prettier": "^3.7.4",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "qs": "^6.15.2",
      "postcss": "^8.5.23",
      "esbuild": "^0.28.1",
      "brace-expansion": "^5.0.9",
      "vite": "^7.3.5",
      "js-yaml": "^4.3.1",
      "nanoid": "^3.3.18"
    }
  }
}
