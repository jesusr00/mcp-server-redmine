{
  "name": "mcp-server-redmine",
  "version": "0.8.1",
  "description": "MCP server for Redmine REST API",
  "type": "module",
  "bin": {
    "mcp-server-redmine": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "redmine",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusr00/mcp-server-redmine.git"
  },
  "homepage": "https://github.com/jesusr00/mcp-server-redmine#readme",
  "bugs": {
    "url": "https://github.com/jesusr00/mcp-server-redmine/issues"
  },
  "author": "Jesus Reikel Lopez Martin",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.1",
      "hono": "^4.13.16",
      "@hono/node-server": "^2.1.3",
      "fast-uri": "^3.1.9",
      "ip-address": "^10.7.4",
      "qs": "^6.16.1",
      "postcss": "^8.5.23",
      "esbuild": "^0.28.1",
      "brace-expansion": "^5.0.12",
      "vite": "^7.3.7",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.18"
    }
  }
}
